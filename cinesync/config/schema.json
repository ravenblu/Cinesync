{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CineSync project profile",
  "type": "object",
  "required": ["config_version", "project", "sequence_name", "cameras", "primary_camera", "export", "player"],
  "properties": {
    "config_version": {"const": 1},
    "project": {"type": "string", "minLength": 1},
    "audio_required": {"type": "boolean", "default": false},
    "sequence_name": {"type": "string"},
    "maya": {"type": "object", "properties": {"mayapy": {"type": "string"}}},
    "primary_camera": {"type": "string"},
    "cameras": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "object", "required": ["label", "type"], "properties": {"track": {"type": "integer", "minimum": 1}, "track_name": {"type": "string", "minLength": 1}, "label": {"type": "string", "minLength": 1}, "type": {"enum": ["body", "face"]}}, "anyOf": [{"required": ["track"]}, {"required": ["track_name"]}]}},
    "export": {"type": "object", "required": ["height", "output_directory", "ffmpeg", "ffprobe"], "properties": {"height": {"enum": [720, 1080]}, "output_directory": {"type": "string"}, "ffmpeg": {"type": "string"}, "ffprobe": {"type": "string"}}},
    "player": {"type": "object", "required": ["cache_megabytes", "prefetch_frames"], "additionalProperties": false, "properties": {"cache_megabytes": {"type": "integer", "minimum": 1}, "prefetch_frames": {"type": "integer", "minimum": 0}}}
  }
}
